// Shared build settings for the ImuLogger app.
//
// The signing team comes from the APPLE_TEAM_ID environment variable (set in
// your shell profile), so no team ID is committed (docs/privacy.md).
// Xcode launched from the Dock doesn't see shell variables; run
// scripts/ios-local-config.sh once to write the git-ignored Local.xcconfig,
// which is included last and overrides anything here.

CWB_BUNDLE_ID_PREFIX = com.popperbiz
PRODUCT_BUNDLE_IDENTIFIER = $(CWB_BUNDLE_ID_PREFIX).ImuLogger
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = $(APPLE_TEAM_ID)

#include? "Local.xcconfig"
